    "If a file with the same name exists, a number is appended. The original is never overwritten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Existiert bereits eine Datei mit diesem Namen, wird eine Nummer angehängt. Das Original wird nie überschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ya existe un archivo con el mismo nombre, se añade un número. El original nunca se sobrescribe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un fichier du même nom existe, un numéro est ajouté. L’original n’est jamais écrasé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前のファイルがある場合は番号が付きます。元のファイルが上書きされることはありません。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı isimde dosya varsa sonuna numara eklenir. Orijinal dosyanın üzerine asla yazılmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如已存在同名文件，会在末尾添加编号。绝不会覆盖原始文件。"
          }
        }
      }
    },
